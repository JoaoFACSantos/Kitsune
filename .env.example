# Copia para .env.local e preenche. Sem chaves, o site usa dados mock.

# URL de produção: metadata, sitemap e JSON-LD.
# Na Vercel, se ficar vazio, usa VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=

# Twitch Helix (app access token, fluxo client credentials): estado do direto, clips mais vistos e seguidores.
# Cria uma aplicação em https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube Data API v3: subscritores no cartão do YouTube.
# Cria uma chave de API em https://console.cloud.google.com/apis/credentials (com a "YouTube Data API v3" ativada).
YOUTUBE_API_KEY=
# ID do canal (começa por "UC"). Está em YouTube > Definições > Definições avançadas.
YOUTUBE_CHANNEL_ID=

# Modo de teste: MOCK_LIVE=true mostra o site "em direto" (botão de play e televisão),
# mesmo com as chaves da Twitch. Não uses em produção.
MOCK_LIVE=

# Analytics sem cookies: escolhe um.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.outbound-links.file-downloads.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
